{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          { "type": "command", "command": "\"$HOME/.agents/skills/orchestrate/hooks/claude/orch-hook.sh\" session-start", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$HOME/.agents/skills/orchestrate/hooks/claude/orch-hook.sh\" stop", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$HOME/.agents/skills/orchestrate/hooks/bin/orch-guard\" pre", "timeout": 5 }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          { "type": "command", "command": "\"$HOME/.agents/skills/orchestrate/hooks/bin/orch-guard\" pre", "timeout": 5 }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Agent|Task|Workflow|Bash",
        "hooks": [
          { "type": "command", "command": "\"$HOME/.agents/skills/orchestrate/hooks/claude/orch-hook.sh\" pretool", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "\"$HOME/.agents/skills/orchestrate/hooks/bin/orch-guard\" coach", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read|LSP|mcp__jbcontext__.*",
        "hooks": [
          { "type": "command", "command": "\"$HOME/.agents/skills/orchestrate/hooks/bin/orch-guard\" coach", "timeout": 5 }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|Read|LSP|mcp__jbcontext__.*",
        "hooks": [
          { "type": "command", "command": "\"$HOME/.agents/skills/orchestrate/hooks/bin/orch-guard\" coach", "timeout": 5 }
        ]
      }
    ]
  }
}
