{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$HOME/.agents/skills/orchestrate/hooks/bin/orch-guard\" pre", "timeout": 5 }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          { "type": "command", "command": "\"$HOME/.agents/skills/orchestrate/hooks/bin/orch-guard\" pre", "timeout": 5 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "\"$HOME/.agents/skills/orchestrate/hooks/bin/orch-guard\" coach", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read|LSP|mcp__jbcontext__.*",
        "hooks": [
          { "type": "command", "command": "\"$HOME/.agents/skills/orchestrate/hooks/bin/orch-guard\" coach", "timeout": 5 }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|Read|LSP|mcp__jbcontext__.*",
        "hooks": [
          { "type": "command", "command": "\"$HOME/.agents/skills/orchestrate/hooks/bin/orch-guard\" coach", "timeout": 5 }
        ]
      }
    ]
  }
}
