{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$HOME/.agents/skills/orchestrate/hooks/claude/deny-find-chains.sh\"" },
          { "type": "command", "command": "\"$HOME/.agents/skills/orchestrate/hooks/claude/deny-sed-inplace.sh\"" },
          { "type": "command", "command": "\"$HOME/.agents/skills/orchestrate/hooks/claude/deny-cat-head-tail.sh\"" },
          { "type": "command", "command": "\"$HOME/.agents/skills/orchestrate/hooks/claude/deny-grep-rg.sh\"" }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          { "type": "command", "command": "\"$HOME/.agents/skills/orchestrate/hooks/claude/deny-big-read.sh\"", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read|LSP|mcp__jbcontext__.*",
        "hooks": [
          { "type": "command", "command": "\"$HOME/.agents/skills/orchestrate/hooks/claude/lookup-coach.sh\"", "timeout": 5 }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|Read|LSP|mcp__jbcontext__.*",
        "hooks": [
          { "type": "command", "command": "\"$HOME/.agents/skills/orchestrate/hooks/claude/lookup-coach.sh\"", "timeout": 5 }
        ]
      }
    ]
  }
}
